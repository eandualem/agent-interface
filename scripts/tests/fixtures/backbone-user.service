[Unit]
Description=agent-backbone — local control plane for terminal AI agents
After=default.target

[Service]
ExecStart='/home/fixture $$cash%%/tools/bin/backbone' up
Environment='BACKBONE_DATA_DIR=/home/fixture $cash%%/data'
Environment=PATH=/usr/bin:/bin
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
