+/// Apply one parsed SGR sequence without storing its intermediate styles.
+/// If allocation fails, restore the old style and use per-attribute recovery.
+pub fn setAttributes(self: *Screen, parser: *sgr.Parser) void {
+    const original = parser.*;
+    const old_style = self.cursor.style;
+    while (parser.next()) |attr| self.applyAttribute(attr);
+    if (self.cursor.style.eql(old_style)) return;
+    self.manualStyleUpdate() catch {
+        self.cursor.style = old_style;
+        self.manualStyleUpdate() catch {
+            self.cursor.style = .{};
+            self.manualStyleUpdate() catch unreachable;
+        };
+        var retry = original;
+        while (retry.next()) |attr| self.setAttribute(attr) catch {};
+    };
+}
